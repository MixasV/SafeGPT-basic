# ---------------------------------------------------------------------------
# SafeGPT Core - environment file
#
# ONE FILE FOR THE WHOLE PROJECT.
#
#   cp .env.example .env
#
# The bot, the web interface and the contracts tooling all read this file.
# The bot looks in `<project>/.env`, the web interface is built with this
# directory as its env directory. Nothing outside this project is read, so a
# copy of the folder carries its own configuration with it.
#
# Only the VITE_ prefixed values reach the browser bundle. Everything else
# here — the Telegram token, the executor key — stays on the machine.
#
# Every value here is a secret. `.env` is in `.gitignore`; never commit it.
# ---------------------------------------------------------------------------

# ===========================================================================
# TELEGRAM ALERTS
# ===========================================================================
# Both values, or neither. With only one of them the bot refuses to start,
# because a silently dead alert channel is worse than a startup error.
#
#  1. Message @BotFather, send /newbot, copy the token.
#  2. Open your bot's page and send it any message — a bot cannot message you
#     first, so there has to be a message for it to reply to.
#  3. Read your numeric chat id from
#     https://api.telegram.org/bot<TOKEN>/getUpdates
#
# Optional: without these the bot still runs, and still prints every alert to
# the console. Add them and the alerts also arrive on your phone.
TG_BOT_TOKEN=
TG_CHAT_ID=

# ===========================================================================
# EXECUTOR KEY
# ===========================================================================
# Required for Variant A. The address derived from this key must equal the
# vault's `executor`; the bot refuses to send a rescue otherwise.
#
# Keep it out of the config file — the config refers to it as ENV:EXECUTOR_KEY.
EXECUTOR_KEY=

# ===========================================================================
# VARIANT B (guardian) - only if you use it
# ===========================================================================
# The guardian key must be unique per wallet. A shared one would mean a single
# compromise controls every account.
GUARDIAN_KEY=

# ===========================================================================
# WEB INTERFACE
# ===========================================================================
# Only the VITE_ prefixed values reach the browser bundle. Everything else in
# this file stays on the machine.
#
# WalletConnect project id from https://cloud.walletconnect.com
# Get a free project ID there (takes ~2 minutes). Leave empty to offer
# browser-injected wallets only (MetaMask, Rabby, Brave).
VITE_WALLETCONNECT_PROJECT_ID=

# Alchemy API key for the ERC-20 balance scan (UPD-4, scan level 1).
# Get a free key at https://dashboard.alchemy.com. Without it the app falls back
# to the explorer API and then to the bundled token list.
VITE_ALCHEMY_API_KEY=

# ===========================================================================
# DEMO MODE
# ===========================================================================
# Runs the full flow without broadcasting transactions, for presentations and
# screenshots. Shows a banner across the app.
# Leave false for real self-hosting.
VITE_DEMO_MODE=false
