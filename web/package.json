{
  "name": "safegpt-core-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SafeGPT open-source protection dashboard (safegpt-core).",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "start:local": "node scripts/start-local.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "build:demo": "node scripts/check-public-build.mjs && vite build --mode demo",
    "build:pages": "node scripts/check-public-build.mjs && vite build --mode demo",
    "deploy:pages": "npm run build:pages && gh-pages -d dist"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.104.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "viem": "^2.57.7",
    "wagmi": "^2.19.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/node": "^26.6.5",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
