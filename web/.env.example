# WalletConnect project id from https://cloud.walletconnect.com.
# Leave empty to offer browser-injected wallets only (MetaMask, Rabby, Brave).
VITE_WALLETCONNECT_PROJECT_ID=

# Section 9 of the specification: runs the full onboarding flow without
# broadcasting real transactions. Shows a banner across the app.
VITE_DEMO_MODE=false